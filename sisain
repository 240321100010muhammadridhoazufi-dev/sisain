                const imgId = `slot-preview-img-${idx}`;

                const containerStyle = isDark
                    ? 'border-white/25 bg-white/5 hover:bg-white/10 text-sisain-light/90'
                    : 'border-sisain-green/30 bg-white/80 hover:bg-sisain-light/50 text-sisain-green';

                const heightClass = isCompact ? 'h-28' : 'h-36';

                box.innerHTML = `
                    <input type="file" id="${inputId}" accept="image/*" class="hidden">
                    <div class="slot-empty rounded-2xl border-2 border-dashed ${containerStyle} p-3 text-center cursor-pointer transition flex flex-col items-center justify-center gap-1.5 ${heightClass}">
                        <i data-lucide="image-plus" class="w-5 h-5 opacity-80"></i>
                        <span class="text-xs font-semibold leading-tight">${label}</span>
                        <span class="text-[10px] opacity-70">Klik untuk pilih 1 gambar</span>
                    </div>
                    <div class="slot-filled hidden relative rounded-2xl overflow-hidden border ${isDark ? 'border-white/20 bg-black/30' : 'border-sisain-green/20 bg-white'} group">
                        <img id="${imgId}" src="" alt="${label}" class="w-full ${heightClass} object-cover cursor-pointer">
                        <div class="absolute inset-0 bg-black/45 opacity-0 group-hover:opacity-100 transition flex items-center justify-center gap-2 p-2">
                            <button type="button" class="btn-zoom px-2.5 py-1.5 rounded-lg bg-white text-sisain-dark text-[11px] font-semibold flex items-center gap-1 shadow">
                                <i data-lucide="maximize-2" class="w-3.5 h-3.5"></i> Lihat
                            </button>
                            <button type="button" class="btn-change px-2.5 py-1.5 rounded-lg bg-sisain-green text-white text-[11px] font-semibold flex items-center gap-1 shadow">
                                <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i> Ganti
                            </button>
                            <button type="button" class="btn-remove p-1.5 rounded-lg bg-red-600 text-white text-[11px] shadow" title="Hapus Gambar">
                                <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                            </button>
                        </div>
                    </div>
                `;

                const fileInput = box.querySelector(`#${inputId}`);
                const emptyBox = box.querySelector('.slot-empty');
                const filledBox = box.querySelector('.slot-filled');
                const previewImg = box.querySelector(`#${imgId}`);

                emptyBox.addEventListener('click', () => fileInput.click());
                box.querySelector('.btn-change').addEventListener('click', (e) => {
                    e.stopPropagation();
                    fileInput.click();
                });
                box.querySelector('.btn-zoom').addEventListener('click', (e) => {
                    e.stopPropagation();
                    openLightbox(imgId);
                });
                previewImg.addEventListener('click', () => openLightbox(imgId));

                box.querySelector('.btn-remove').addEventListener('click', (e) => {
                    e.stopPropagation();
                    fileInput.value = '';
                    previewImg.src = '';
                    filledBox.classList.add('hidden');
                    emptyBox.classList.remove('hidden');
                });

                fileInput.addEventListener('change', (e) => {
                    const file = e.target.files[0];
                    if (!file) return;
                    const reader = new FileReader();
                    reader.onload = (ev) => {
                        previewImg.src = ev.target.result;
                        emptyBox.classList.add('hidden');
                        filledBox.classList.remove('hidden');
                        showToast('Gambar Ditambahkan', `${label} berhasil dimuat.`);
                    };
                    reader.readAsDataURL(file);
                });
            });
        }

        // Jalankan pembuatan slot upload lalu render ikon Lucide
        initUploadSlots();
        lucide.createIcons();

        // Toggle Menu Mobile
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        document.querySelectorAll('.mobile-link').forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
            });
        });

        // Switcher Mode Panduan Penggunaan (Dengan Sekat vs Tanpa Sekat)
        function switchUsageMode(mode) {
            const btnSekat = document.getElementById('btn-mode-sekat');
            const btnTanpa = document.getElementById('btn-mode-tanpa');
            const desc = document.getElementById('mode-description');
            const step1 = document.getElementById('step1-text');

            if (mode === 'sekat') {
                btnSekat.className = "px-4 sm:px-6 py-2.5 rounded-xl text-sm font-semibold bg-sisain-green text-white transition";
                btnTanpa.className = "px-4 sm:px-6 py-2.5 rounded-xl text-sm font-semibold text-stone-600 hover:text-sisain-green transition";
                desc.innerHTML = "<strong>Mode Dengan Sekat:</strong> Pasang sekat silikon di dalam wadah untuk memisahkan nasi (450 ml), lauk gorengan (150 ml), dan jajanan/sayur (150 ml) agar rasa tidak bercampur.";
                step1.textContent = "Masukkan nasi pada kompartemen besar dan pisahkan lauk atau camilan ke dua sekat kecil agar tetap renyah dan rapi.";
            } else {
                btnTanpa.className = "px-4 sm:px-6 py-2.5 rounded-xl text-sm font-semibold bg-sisain-green text-white transition";
                btnSekat.className = "px-4 sm:px-6 py-2.5 rounded-xl text-sm font-semibold text-stone-600 hover:text-sisain-green transition";
                desc.innerHTML = "<strong>Mode Tanpa Sekat:</strong> Lepas kedua sekat silikon untuk mendapatkan kapasitas penuh—cocok untuk makanan berkuah, sup, mie, atau porsi besar.";
                step1.textContent = "Angkat sekat silikon dari wadah utama, lalu tuangkan makanan berkuah atau porsi besar secara merata ke dalam wadah.";
            }
        }

        // Lightbox Controls
        function openLightbox(imgId = 'prototype-main-img') {
            const targetImg = document.getElementById(imgId) || document.getElementById('prototype-main-img');
            document.getElementById('lightbox-img').src = targetImg.src;
            document.getElementById('lightbox-modal').classList.remove('hidden');
        }
        function closeLightbox() {
            document.getElementById('lightbox-modal').classList.add('hidden');
        }

        // Fallback jika gambar lokal belum terhubung
        function handlePrototypeFallback(imgEl) {
            imgEl.classList.add('hidden');
            document.getElementById('prototype-fallback-box').classList.remove('hidden');
        }

        function handleGalleryFallback(imgEl) {
            imgEl.classList.add('hidden');
            document.getElementById('gallery-fallback-box').classList.remove('hidden');
        }

        // Modal Uploader Gambar Lokal
        function openPhotoUploader() {
            document.getElementById('uploader-modal').classList.remove('hidden');
        }
        function closePhotoUploader() {
            document.getElementById('uploader-modal').classList.add('hidden');
        }

        function previewCustomImage(event, target) {
            const file = event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                if (target === 'logo') {
                    document.querySelectorAll('img[alt="Logo SisaIn"]').forEach(img => {
                        img.src = e.target.result;
                        img.style.display = 'block';
                    });
                    const fallbackLogo = document.getElementById('fallback-logo');
                    if (fallbackLogo) fallbackLogo.classList.add('hidden');
                    showToast('Logo Diperbarui', 'Gambar logo SisaIn berhasil dimuat.');
                } else if (target === 'gallery') {
                    const galleryImg = document.getElementById('gallery-visual-img');
                    galleryImg.src = e.target.result;
                    galleryImg.classList.remove('hidden');
                    document.getElementById('gallery-fallback-box').classList.add('hidden');
                    showToast('Galeri Diperbarui', 'Gambar aktivitas & perawatan berhasil ditampilkan.');
                } else {
                    const mainImg = document.getElementById('prototype-main-img');
                    mainImg.src = e.target.result;
                    mainImg.classList.remove('hidden');
                    document.getElementById('prototype-fallback-box').classList.add('hidden');
                    showToast('Prototype Diperbarui', 'Gambar asli prototype berhasil ditampilkan.');
                }
            };
            reader.readAsDataURL(file);
        }

        // Form Kontak Handler
        function handleContactSubmit(event) {
            event.preventDefault();
            const nama = document.getElementById('nama').value;
            showToast('Pesan Terkirim!', `Terima kasih ${nama}, tim SisaIn akan segera menghubungi Anda.`);
            event.target.reset();
        }

        // Toast Notification
        function showToast(title, message) {
            const toast = document.getElementById('toast-box');
            document.getElementById('toast-title').textContent = title;
            document.getElementById('toast-msg').textContent = message;
            toast.classList.remove('hidden');
            setTimeout(() => {
                toast.classList.add('hidden');
            }, 4000);
        }
    </script>
</body>
</html>
